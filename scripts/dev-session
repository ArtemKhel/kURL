#!/usr/bin/env bash
set -Eeuox pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
layout="$repo_root/.config/zellij/dev.kdl"
session="kurlyk-dev-${KITTY_WINDOW_ID:-$$}"
telemetry=(prometheus loki tempo alloy grafana)
declare -A telemetry_was_running=()
manage_telemetry=false

cd "$repo_root"

for service in "${telemetry[@]}"; do
    if docker compose ps --status running --services | grep -qx "$service"; then
        telemetry_was_running["$service"]=1
    fi
done

cleanup() {
    local status=$?
    local service
    local -a stop=()

    trap - EXIT HUP INT TERM
    zellij kill-session "$session" >/dev/null 2>&1 || true

    if [[ "$manage_telemetry" == true ]]; then
        for service in "${telemetry[@]}"; do
            if [[ -z "${telemetry_was_running[$service]+x}" ]] &&
                docker compose ps --status running --services | grep -qx "$service"; then
                stop+=("$service")
            fi
        done
    fi

    if ((${#stop[@]})); then
        docker compose stop "${stop[@]}"
    fi

    exit "$status"
}

trap cleanup EXIT HUP INT TERM

if [[ "$(tq '.logging.enabled' < config/config.toml)" == "true" ]]; then
    manage_telemetry=true
    docker compose up -d --wait "${telemetry[@]}"
fi

zellij --new-session-with-layout "$layout" options --session-name "$session"
