// Grafana Alloy unified telemetry configuration (logs, metrics, traces)

// Docker container log collection -> Loki
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// OTLP Receiver for traces, metrics, and logs
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.exporter.loki.default.input]
  }
}

// Forward Traces to Tempo
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// Forward Logs to Loki
otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

// Scrape Prometheus metrics from Rust service listener ports (9100) periodically
prometheus.scrape "rust_services" {
  targets = [
    {"__address__" = "gateway:9100", "service" = "gateway"},
    {"__address__" = "core:9100", "service" = "core"},
    {"__address__" = "analytics:9100", "service" = "analytics"},
  ]
  scrape_interval = "10s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.scrape "local_rust_services" {
  targets = [
    {"__address__" = "host.docker.internal:9100", "service" = "gateway"},
    {"__address__" = "host.docker.internal:9101", "service" = "core"},
    {"__address__" = "host.docker.internal:9102", "service" = "analytics"},
  ]
  scrape_interval = "10s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// Forward OTLP metrics to Prometheus via Remote Write
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

// Forward Metrics to Prometheus via Remote Write
prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
